{
  "name": "hr-platform-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 6001",
    "build": "next build",
    "start": "next start -p 6001",
    "build:mobile": "CAPACITOR_BUILD=true next build",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
